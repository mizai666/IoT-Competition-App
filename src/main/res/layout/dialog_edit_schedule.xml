<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="显示名称"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <EditText
                android:id="@+id/et_display_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="JSON 键名 (key_name)"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <EditText
                android:id="@+id/et_key_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="发布主题"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <EditText
                android:id="@+id/et_publish_topic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="倒计时秒数 (schedule_time)"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <EditText
                android:id="@+id/et_schedule_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/cb_active_high"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="高电平点亮（选中：开=1；未选：开=0）"
            android:checked="true"
            android:textSize="14sp"
            android:textColor="#374151" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_target_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="定时开启（开=开，关=关）"
            android:checked="true"
            android:textSize="14sp"
            android:textColor="#374151" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="启用"
            android:checked="true"
            android:textSize="14sp"
            android:textColor="#374151" />

        <!-- 响应规则区（可选） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="响应规则（可选，留空则不参与匹配）"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1F2937" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="数组路径 (resp_array_path)"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <EditText
                android:id="@+id/et_resp_array_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="目标字段 (resp_target_key)"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <EditText
                android:id="@+id/et_resp_target_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="命令字段 (resp_command_key)"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <EditText
                android:id="@+id/et_resp_command_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
