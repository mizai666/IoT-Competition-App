<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="显示名称"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <EditText
                android:id="@+id/et_display_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="JSON 键名 (key_name)"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <EditText
                android:id="@+id/et_json_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="发布主题"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <EditText
                android:id="@+id/et_publish_topic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/cb_active_high"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="高电平点亮（选中：开=1, 关=0；未选：开=0, 关=1）"
            android:checked="true"
            android:textSize="14sp"
            android:textColor="#374151" />

        <!-- 响应规则区（可选） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="响应规则（可选，留空则不参与匹配）"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1F2937" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="数组路径 (resp_array_path)"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <EditText
                android:id="@+id/et_resp_array_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="目标字段 (resp_target_key)"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <EditText
                android:id="@+id/et_resp_target_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="命令字段 (resp_command_key)"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <EditText
                android:id="@+id/et_resp_command_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="自定义值映射 (如 on:开,off:关)"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
            <EditText
                android:id="@+id/et_resp_value_map"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
