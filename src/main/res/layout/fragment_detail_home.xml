<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFBFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 传感器选择卡片（保持不变） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sensor_select_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <Spinner
                    android:id="@+id/spinner_sensor"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_refresh_chart"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:text="刷新"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="#6366F1"
                    app:cornerRadius="10dp"
                    app:strokeColor="#C7D2FE"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 图表容器卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/chart_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- 图表类型切换 -->
            <RadioGroup
                android:id="@+id/rg_chart_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">
                <RadioButton
                    android:id="@+id/rb_chart_line"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="折线图"
                    android:checked="true"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="#6B7280" />
                <RadioButton
                    android:id="@+id/rb_chart_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="柱状图"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="#6B7280" />
                <RadioButton
                    android:id="@+id/rb_chart_pie"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="饼图"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="#6B7280" />
            </RadioGroup>

            <!-- 折线图，高度固定 400dp -->
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/line_chart"
                android:layout_width="match_parent"
                android:layout_height="400dp" />

            <!-- 柱状图（初始隐藏） -->
            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/bar_chart"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:visibility="gone" />

            <!-- 饼图（初始隐藏） -->
            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pie_chart"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:visibility="gone" />

            <!-- 自定义图例容器 -->
            <LinearLayout
                android:id="@+id/legend_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="图例"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:id="@+id/legend_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignBounds"
                    android:columnOrderPreserved="false" />

                 </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 传感器实时数据标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="传感器实时数据"
            android:textColor="#1F2937"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 传感器实时数据列表卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sensor_data"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:nestedScrollingEnabled="true"
                android:padding="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 实时 JSON 数据卡片 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:text="实时 JSON 数据"
            android:textColor="#1F2937"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tv_realtime_json"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:textColor="#374151"
                android:text="{}" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>